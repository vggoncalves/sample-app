{
  "name": "sample-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:container": "ng serve --host 0.0.0.0",
    "start:cont-prx": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "start:en": "ng serve --configuration en --proxy-config proxy.conf.json",
    "build": "ng build",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "i18n:drafts": "./scripts/generate-i18n-drafts.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "./scripts/test-coverage.sh",
    "verify:coverage": "test -s coverage/sample-app/lcov.info",
    "presonar": "npm run test:coverage",
    "sonar": "sonar-scanner-npm"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/localize": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@sonar/scan": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
